# ==========================================
# J.A.R.V.I.S. Open Source Git Ignore
# ==========================================

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets (CRITICAL: Never commit API keys)
.env
.env.local
.env.*.local

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Heavy model weights & binary caches (> 100MB)
models/
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
jarvis_lora_adapter/

# Personal Biometrics & Local Memory Data
# (Each user generates their own voice profile and local memory)
voice_profile.npy
*.npy
jarvis_memory.json
traces.jsonl
dataset_jarvis_sft.json

# Operating System & IDE files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Temporary scratch scripts & logs
scratch/
*.log
