# ==========================================
# J.A.R.V.I.S. Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==========================================

# Local Ollama Daemon Configuration
JARVIS_OLLAMA_HOST=http://localhost:11434
JARVIS_OLLAMA_MODEL=jarvis

# Voice Biometrics Verification Sensitivity (0.0 to 1.0, default: 0.70)
JARVIS_VERIFY_THRESHOLD=0.70
